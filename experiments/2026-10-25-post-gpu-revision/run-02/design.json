{
  "schema": "edmir.post-gpu-revision.v1",
  "rho_grid": [
    0,
    0.25,
    0.5,
    0.75,
    1
  ],
  "controls": [
    "regime_max",
    "residual_depth",
    "row_service"
  ],
  "axes": [
    "shape",
    "M",
    "N"
  ],
  "contexts_separate": true,
  "repeat_labels_used_for_fit": false,
  "extension_used_for_fit": false,
  "host_expression_unchanged": true,
  "primary_budget": 2,
  "secondary_budgets": [
    1,
    3
  ],
  "near_optimal_fraction": 0.05,
  "per_fit_timeout_seconds": 10,
  "whole_run_timeout_seconds": 900,
  "independent_validation": false,
  "compiler_admission": false,
  "paper": "https://arxiv.org/html/2204.14242v1",
  "acceptance": {
    "macro_shape_mean_absolute_percentage_error_max": 0.1,
    "max_candidate_absolute_percentage_error_max": 0.25,
    "wrong_pair_decisions_with_over_10_percent_loss_max": 0
  },
  "stop_rule": "No further total-latency features if the bounded revision fails robust counterexamples or regresses matched old/new selection losses; require diagnostic evidence."
}
